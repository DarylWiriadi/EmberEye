---
import { Icon } from 'astro-icon/components';
import HeroMap from './HeroMap.astro';
import SimPreview from './SimPreview.astro';
import SplitWords from './SplitWords.astro';
import { pages, site } from '../../lib/site';
---

<!--
  Poster-style hero, designed at 1440px wide. Everything inside (text, spacing,
  the visual) is sized in em of .hero, so it scales as one piece and the
  arrangement never changes.
  - The scale follows the window's width AND height, whichever is tighter, so the
    whole hero always fits in the first screen: at any zoom level (e.g. Windows'
    common 125% scaling) and on short or wide screens.
  - The hero is at least one screen tall, so the next section never peeks in
    when zoomed out.
  - It only stacks on real phones (touch screens under 768px wide), or when the
    window is under 480px (e.g. extreme zoom), where two columns can't fit.
  The rem values inside max() are deliberate floors (14px text, 44px buttons),
  so text still grows when someone zooms in to read.
-->
<section class="hero" aria-labelledby="hero-title">
  <HeroMap />
  <div class="hero-inner">
    <div class="hero-copy" data-reveal-group="load">
      <p class="hero-eyebrow">Track fire activity across time and place</p>
      <h1 id="hero-title" class="hero-title" aria-label={site.tagline} data-reveal-words>
        <SplitWords text={site.tagline} />
      </h1>
      <p class="hero-subtitle">
        {site.name} merges NASA’s MODIS and VIIRS satellite hotspots into one harmonized history,
        so you can see when and where fires burn, spot unusual seasons and compare today with the
        past, anywhere on Earth.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary hero-btn" href={pages.dashboard}>
          Open the dashboard
          <Icon name="lucide:arrow-right" aria-hidden="true" />
        </a>
        <a class="btn btn-secondary hero-btn" href="#how-it-works">How it works</a>
      </div>
    </div>

    <!-- A live preview of the dashboard's fire-spread simulation (SimPreview.astro) -->
    <div class="hero-visual" data-reveal="load">
      <SimPreview />
    </div>
  </div>
</section>

<style>
  .hero {
    /*
     * One scale for the whole hero (16px on a 1440px-wide screen), the smallest of:
     *   - the width fit: 1440px wide -> 16px
     *   - the height fit: the hero content is about 40em tall (the square visual
     *     plus padding), so the space below the nav divided by 42 keeps it on screen
     *   - a cap of 20px for very large screens
     */
    --hero-scale: min(1.1111vw, calc((100svh - var(--nav-height)) / 42), 1.25rem);
    /* Text follows the same scale (its em resolves against the hero scale). */
    --hero-text: 1em;
    font-size: var(--hero-scale);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Always fill the first screen (below the sticky nav), at any zoom level,
       so the next section never peeks in. Content is centred vertically.
       svh = the screen height with mobile browser bars showing (no jumping). */
    min-height: calc(100svh - var(--nav-height));
    display: grid;
    align-items: center;
  }

  /* Film grain over the hero background (same texture as the story below) */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--texture-grain);
    opacity: 0.05;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1; /* above the map and grain */
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 5em;
    width: 100%;
    max-width: 90em;
    margin-inline: auto;
    /* Vertical centring (on .hero) provides the space above and below. */
    padding: 3em 5em;
  }

  /* gap (not margins) so spacing follows the hero scale, not each child's font size */
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75em;
  }

  .hero-eyebrow {
    margin-bottom: -0.5em;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: max(0.875rem, calc(0.875 * var(--hero-text)));
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ember);
    text-wrap: balance; /* if it wraps (narrow screens), two even lines */
  }

  .hero-title {
    font-size: calc(4.75 * var(--hero-text));
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    max-width: 32em;
    font-size: max(0.875rem, calc(1.3125 * var(--hero-text)));
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    gap: 1em;
    padding-top: 0.75em;
  }

  .hero-btn {
    font-size: max(0.9375rem, calc(1.0625 * var(--hero-text)));
    min-height: max(2.75rem, 3.25em);
    padding-inline: 1.5em;
  }

  .hero-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 0.0625em solid var(--color-border-strong);
    border-radius: 1.5em;
    /* See-through, so the world fire map behind the hero shows through the
       preview's terrain (SimPreview.astro dims it) */
    background: color-mix(in srgb, var(--color-surface) 20%, transparent);
    box-shadow: 0 1.5em 4em -1em rgb(0 0 0 / 0.6);
  }

  /* Phones (touch screens under 768px), or any window under 480px: drop the
     poster layout and stack text above the visual. Desktop zoom alone doesn't
     trigger this until two columns genuinely can't fit. */
  @media (max-width: 47.99rem) and (hover: none) and (pointer: coarse), (max-width: 29.99rem) {
    .hero {
      --hero-text: 1rem;
      font-size: 1rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      padding: var(--space-2xl) var(--gutter) var(--space-3xl);
    }

    .hero-title {
      font-size: 2.5em;
    }

    .hero-subtitle {
      font-size: var(--text-lg);
    }

    .hero-actions {
      flex-wrap: wrap;
    }
  }
</style>
