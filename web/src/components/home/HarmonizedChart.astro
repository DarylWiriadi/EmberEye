---
import SectionHeader from './SectionHeader.astro';
---

<!-- Placeholder until the pipeline's validation step produces the real series -->
<section id="harmonized" class="section" aria-labelledby="harmonized-title">
  <div class="container">
    <SectionHeader
      eyebrow="Harmonization"
      title="Raw vs harmonized"
      headingId="harmonized-title"
      lede="We calibrate MODIS against VIIRS where the two overlap, then rebuild the whole record in VIIRS-equivalent counts. The jump at 2012 disappears."
    />

    <figure class="chart">
      <div class="chart-placeholder">
        <span>Chart placeholder</span>
      </div>
      <figcaption class="chart-caption">
        Monthly hotspot counts, raw and harmonized. Real data will appear here once the pipeline’s
        validation step is complete.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .chart-placeholder {
    display: grid;
    place-items: center;
    width: 100%; /* explicit width so min-height grows the box downward, never sideways */
    aspect-ratio: 16 / 7;
    min-height: 14rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .chart-caption {
    margin-top: var(--space-s);
    max-width: var(--prose-width);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
