---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import { pages } from '../../lib/site';

// Draft copy; final text in issue #5
const features = [
  {
    icon: 'lucide:calendar-days',
    title: 'Burning calendar',
    text: 'See busy and quiet months at a glance, from 2002 to today, for any area you choose.',
  },
  {
    icon: 'lucide:git-compare',
    title: 'Compare against history',
    text: 'Find out whether this month is above or below the long-term median, and by how much.',
  },
  {
    icon: 'lucide:flame',
    title: 'Simulate spread',
    text: 'Start a fire on the map and see an estimate of where it could spread over the next 72 hours.',
  },
];
---

<section id="approach" class="section" aria-labelledby="approach-title">
  <div class="container">
    <SectionHeader
      eyebrow="What you can do"
      title="From twenty years of hotspots to answers"
      headingId="approach-title"
    />

    <ul class="feature-grid" role="list" data-reveal-group>
      {
        features.map((f) => (
          <li class="card feature">
            <span class="feature-icon">
              <Icon name={f.icon} aria-hidden="true" />
            </span>
            <h3>
              <a class="card-link" href={pages.dashboard}>
                {f.title}
              </a>
            </h3>
            <p class="muted">{f.text}</p>
            <span class="feature-arrow" aria-hidden="true">
              <Icon name="lucide:arrow-up-right" />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feature-grid {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 48rem) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2xs);
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--color-ember) 14%, transparent);
    color: var(--color-ember);
  }

  .feature-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Corner arrow: shows the card opens the dashboard (no hover on touch screens) */
  .feature-arrow {
    position: absolute;
    top: clamp(var(--space-m), 2.5vw, var(--space-l));
    right: clamp(var(--space-m), 2.5vw, var(--space-l));
    color: var(--color-text-subtle);
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .feature-arrow :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (hover: hover) {
    .feature:has(.card-link:hover) .feature-arrow {
      color: var(--color-ember);
      transform: translate(2px, -2px);
    }
  }
</style>
