---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import terrain from '../../assets/sim-preview-terrain.webp';
import finalFrame from '../../assets/sim-preview-final.webp';
import sim from '../../data/sim-preview.json';
import { pages } from '../../lib/site';

/*
 * Hero preview of the fire-spread simulation. Not a video: a small dataset
 * baked by web/scripts/sim-preview.mts, which runs the dashboard's own model once
 * (same inputs and seed as the dashboard link below, so it's the same fire).
 * A canvas redraws the fire from it: each burnt cell's ignition and burn-out time.
 *
 * Plays 24 hours in about 8 s, holds, fades and loops; only while on screen.
 * Reduced motion: shows the fire after 24 h, with a play button.
 * No JavaScript: a still image of the fire after 24 h.
 */
const COMPASS = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
// Same words as the dashboard's Simulate panel
const fwiWord = (fwi: number) => (fwi < 10 ? 'low' : fwi < 25 ? 'moderate' : fwi < 40 ? 'high' : fwi < 55 ? 'very high' : 'extreme');
const { scenario } = sim;
const wind = `${COMPASS[Math.round(scenario.windFromDeg / 45) % 8]} wind ${scenario.windKmh} km/h`;
const totalHa = sim.areaHa[sim.areaHa.length - 1];
const href = `${pages.dashboard}?${sim.dashboardQuery}`;
---

<figure class="sim" data-sim-preview>
  <!-- The whole map opens this simulation in the dashboard (same inputs and seed) -->
  <a class="sim-link" href={href}>
    <span class="visually-hidden">Open this simulation in the dashboard</span>
  </a>
  <div class="sim-map" aria-hidden="true">
    <Image
      src={terrain}
      alt=""
      widths={[480, 720, 960, 1152]}
      sizes="(max-width: 47.99rem) 92vw, 36rem"
      loading="eager"
      class="sim-terrain"
    />
    <Image src={finalFrame} alt="" class="sim-still" />
    <canvas class="sim-fire" width={sim.cols} height={sim.rows}></canvas>
    <span class="sim-ignition" style={`--x: ${sim.ignition.x}%; --y: ${sim.ignition.y}%`}></span>
    {
      sim.labels.map((l) => (
        <span class={`sim-label sim-label--${l.kind}`} style={`--x: ${l.x}%; --y: ${l.y}%`}>
          {l.name}
        </span>
      ))
    }
  </div>

  <div class="sim-top" aria-hidden="true">
    <span class="sim-chip">Simulated estimate</span>
    <span class="sim-open">
      Open
      <Icon name="lucide:arrow-up-right" />
    </span>
  </div>

  <div class="sim-bottom">
    <div class="sim-readout" aria-hidden="true">
      <p class="sim-area"><span data-sim-area>{Math.round(totalHa / 1000)}k ha</span> burned</p>
      <p class="sim-meta">
        <span class="sim-clock"><span data-sim-hour>Hour {scenario.hours}</span> of {scenario.hours}</span>{' · '}{wind} ·{' '}
        {fwiWord(scenario.fwi)} dryness
      </p>
    </div>
    <button class="sim-toggle" type="button" data-sim-toggle aria-label="Pause the simulation" hidden>
      <Icon name="lucide:pause" class="sim-icon-pause" aria-hidden="true" />
      <Icon name="lucide:play" class="sim-icon-play" aria-hidden="true" />
    </button>
  </div>

  <figcaption class="visually-hidden">
    Simulated fire spread over {scenario.hours} hours from an ignition in the Jamison Valley, {sim.place}, with a {wind}
    and {fwiWord(scenario.fwi)} dryness: about {Math.round(totalHa / 1000)},000 hectares. A model estimate, not a forecast.
  </figcaption>
</figure>

<style>
  .sim {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    border-radius: inherit;
    isolation: isolate;
  }

  .sim-link,
  .sim-map,
  .sim-map > :global(img),
  .sim-fire {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sim-map > :global(img) {
    object-fit: fill;
  }

  /* The link covers the panel; the map and readout sit above it but let taps
     through (pointer-events: none), except the play/pause button */
  .sim-link {
    z-index: 2;
    border-radius: inherit;
  }

  .sim-link:focus-visible {
    outline: 0.1875rem solid var(--color-focus);
    outline-offset: -0.1875rem;
  }

  .sim-map,
  .sim-top,
  .sim-bottom {
    pointer-events: none;
  }

  /* The fire grid is small (one pixel per ~400 m cell); the browser scales it
     up smoothly, which gives the soft glowing edge */
  .sim-fire {
    filter: drop-shadow(0 0 0.35em color-mix(in srgb, var(--color-ember) 55%, transparent));
  }

  /* Without JavaScript only the still is shown; with it, the canvas */
  .sim-fire {
    display: none;
  }

  .sim.is-live .sim-fire {
    display: block;
  }

  .sim.is-live .sim-map > :global(.sim-still) {
    display: none;
  }

  .sim-ignition {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0.7em;
    height: 0.7em;
    border: 0.15em solid var(--color-on-flame);
    border-radius: 50%;
    background: var(--color-ember);
    box-shadow: 0 0 0.6em var(--color-ember);
    transform: translate(-50%, -50%);
  }

  .sim-label {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-size: max(0.75rem, 0.75em);
    line-height: 1;
    white-space: nowrap;
    color: var(--color-text-muted);
    text-shadow:
      0 0 0.3em var(--color-bg),
      0 0 0.6em var(--color-bg);
  }

  /* Towns: a small dot with the name to its right */
  .sim-label--town {
    transform: translate(-0.25em, -50%);
    padding-left: 0.8em;
  }

  .sim-label--town::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: var(--color-text-muted);
    transform: translateY(-50%);
  }

  .sim-label--water {
    transform: translate(-50%, -50%);
    font-style: italic;
    color: var(--color-sky);
  }

  /* ---------- Overlays (darkened edges keep the text readable over the fire) ---------- */

  .sim-top,
  .sim-bottom {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 0.75em;
    padding: 1em;
  }

  .sim-top {
    top: 0;
    align-items: center;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 75%, transparent), transparent);
  }

  .sim-bottom {
    bottom: 0;
    align-items: flex-end;
    padding-top: 2.5em;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 92%, transparent) 35%, transparent);
  }

  .sim-chip {
    padding: 0.3em 0.75em;
    border: 0.0625em dashed var(--color-ember);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    font-family: var(--font-mono);
    font-size: max(0.75rem, 0.75em);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ember);
  }

  .sim-toggle {
    display: grid;
    place-items: center;
    width: max(2.75rem, 2.75em);
    height: max(2.75rem, 2.75em);
    border: 0.0625em solid var(--color-border-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    color: var(--color-text);
    cursor: pointer;
    pointer-events: auto;
    flex-shrink: 0;
  }

  .sim-toggle[hidden] {
    display: none;
  }

  .sim-toggle :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .sim-toggle[data-state='paused'] :global(.sim-icon-pause),
  .sim-toggle:not([data-state='paused']) :global(.sim-icon-play) {
    display: none;
  }

  @media (hover: hover) {
    .sim-toggle:hover {
      border-color: var(--color-text-muted);
    }
  }

  .sim-readout {
    display: grid;
    gap: 0.25em;
    min-width: 0;
  }

  .sim-meta {
    font-size: max(0.75rem, 0.75em);
    color: var(--color-text-muted);
  }

  .sim-clock {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .sim-area {
    font-family: var(--font-display);
    font-size: max(1.125rem, 1.5em);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  /* A hint that the panel opens the dashboard (the link itself is the whole panel) */
  .sim-open {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0.3em 0.75em;
    border: 0.0625em solid var(--color-border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    font-size: max(0.75rem, 0.8em);
    font-weight: 500;
    color: var(--color-text);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .sim-open :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  @media (hover: hover) {
    .sim:has(.sim-link:hover) .sim-open {
      border-color: var(--color-ember);
      color: var(--color-ember);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sim-ignition {
      animation: ignition-pulse 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes ignition-pulse {
    0%,
    100% {
      box-shadow: 0 0 0.6em var(--color-ember);
    }
    50% {
      box-shadow: 0 0 1.4em var(--color-ember);
    }
  }
</style>

<script>
  import sim from '../../data/sim-preview.json';

  const root = document.querySelector<HTMLElement>('[data-sim-preview]');
  const canvas = root?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');

  if (root && canvas && ctx) {
    const { cols, rows, stepsPerHour, coolHours, areaHa, cells, scenario } = sim;
    const LAST = scenario.hours * stepsPerHour;
    const COOL = coolHours * stepsPerHour;

    // Unpack the burnt cells: index in the grid, step it caught fire, step it burnt out
    const n = cells.idx.length;
    const index = new Uint32Array(n);
    const lit = new Uint16Array(n);
    const out = new Uint16Array(n);
    for (let k = 0, i = 0; k < n; k++) {
      i += cells.idx[k];
      index[k] = i;
      lit[k] = cells.ignited[k];
      out[k] = cells.ignited[k] + cells.burning[k];
    }

    const image = ctx.createImageData(cols, rows);
    const px = image.data;
    const hourEl = root.querySelector('[data-sim-hour]')!;
    const areaEl = root.querySelector('[data-sim-area]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-sim-toggle]')!;

    // Burning front bright; burnt area cools from orange-red to deep red
    // (same colours as the still made by the bake script)
    let drawn = -1;
    const draw = (step: number) => {
      step = Math.floor(step);
      if (step === drawn) return;
      drawn = step;
      px.fill(0);
      for (let k = 0; k < n; k++) {
        if (lit[k] > step) continue;
        const o = index[k] * 4;
        if (out[k] > step) {
          px[o] = 255;
          px[o + 1] = 206;
          px[o + 2] = 84;
          px[o + 3] = 255;
        } else {
          const c = Math.min(1, (step - out[k]) / COOL);
          px[o] = 226 - 116 * c;
          px[o + 1] = 72 - 46 * c;
          px[o + 2] = 30 - 14 * c;
          px[o + 3] = 235 - 25 * c;
        }
      }
      ctx.putImageData(image, 0, 0);

      const hour = step / stepsPerHour;
      const h0 = Math.floor(hour);
      const ha = areaHa[h0] + ((areaHa[Math.min(h0 + 1, areaHa.length - 1)] ?? 0) - areaHa[h0]) * (hour - h0);
      hourEl.textContent = `Hour ${h0}`;
      areaEl.textContent = ha >= 10000 ? `${Math.round(ha / 1000)}k ha` : `${(Math.round(ha / 100) * 100).toLocaleString('en')} ha`;
    };

    // One loop: ignition, 24 hours of spread, hold, fade out (ms)
    const IGNITE = 700;
    const SPREAD = 8000;
    const HOLD = 2500;
    const FADE = 700;
    const LOOP = IGNITE + SPREAD + HOLD + FADE;

    let t = 0;
    let playing = false;
    let onScreen = false;
    let frame = 0;
    let last = 0;

    const render = () => {
      const spread = Math.min(1, Math.max(0, (t - IGNITE) / SPREAD));
      draw(spread * LAST);
      const fade = Math.max(0, t - (IGNITE + SPREAD + HOLD)) / FADE;
      canvas.style.opacity = String(1 - Math.min(1, fade));
    };

    const tick = (now: number) => {
      t = (t + Math.min(100, now - last)) % LOOP;
      last = now;
      render();
      frame = requestAnimationFrame(tick);
    };

    const update = () => {
      cancelAnimationFrame(frame);
      if (playing && onScreen && !document.hidden) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      toggle.dataset.state = on ? 'playing' : 'paused';
      toggle.setAttribute('aria-label', on ? 'Pause the simulation' : 'Play the simulation');
      update();
    };

    root.classList.add('is-live');
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      // After a reduced-motion still, playing starts from the ignition
      if (!playing && t === 0) render();
      setPlaying(!playing);
    });
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      update();
    }).observe(root);
    document.addEventListener('visibilitychange', update);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      draw(LAST);
      setPlaying(false);
    } else {
      render(); // the ignition point, before the page has finished loading
      setPlaying(false);
      // Start once the page and the hero's own load animation have settled
      const start = () => setTimeout(() => setPlaying(true), 900);
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    }
  }
</script>
