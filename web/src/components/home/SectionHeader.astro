---
import SplitWords from './SplitWords.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** id for the heading, so the section can point at it with aria-labelledby */
  headingId: string;
  lede?: string;
}

const { eyebrow, title, headingId, lede } = Astro.props;
---

<header class="section-header" data-reveal-group>
  <p class="eyebrow">{eyebrow}</p>
  <!-- Words rise in one by one (src/scripts/reveal.ts); aria-label keeps it one phrase for screen readers -->
  <h2 id={headingId} aria-label={title} data-reveal-words><SplitWords text={title} /></h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .section-header {
    max-width: var(--prose-width);
    margin-bottom: var(--space-xl);
  }

  .section-header > * + * {
    margin-top: var(--space-s);
  }
</style>
