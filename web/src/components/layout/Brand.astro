---
import { Icon } from 'astro-icon/components';
import { pages, site } from '../../lib/site';
---

<a class="brand" href={pages.home}>
  <Icon name="lucide:flame" class="brand-mark" aria-hidden="true" />
  <span>{site.name}</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    width: 1.35em;
    height: 1.35em;
    color: var(--color-ember);
  }

  @media (hover: hover) {
    .brand:hover {
      color: var(--color-text);
    }
  }
</style>
