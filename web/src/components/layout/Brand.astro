---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { pages, site } from '../../lib/site';
---

<a class="brand" href={pages.home}>
  <!-- alt is empty: the name next to it already labels the link -->
  <Image src={logo} alt="" width={32} height={32} densities={[1, 2, 3]} class="brand-mark" loading="eager" />
  <span>{site.name}</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  @media (hover: hover) {
    .brand:hover {
      color: var(--color-text);
    }
  }
</style>
