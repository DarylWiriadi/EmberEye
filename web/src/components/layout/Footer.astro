---
import { Icon } from 'astro-icon/components';
import Brand from './Brand.astro';
import { pages, site } from '../../lib/site';

const year = 2026;
---

<footer class="site-footer">
  <div class="container footer-grid" data-reveal-group>
    <div class="footer-brand">
      <Brand />
      <p class="muted">{site.tagline}.</p>
      <p class="muted">
        Built by {site.team.join(' and ')} for the NASA Space Apps Challenge {year}.
      </p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <h2 class="footer-heading">Explore</h2>
      <ul role="list">
        <li><a href={pages.dashboard}>Dashboard</a></li>
        <li>
          <a href={site.github} rel="noopener">
            <Icon name="lucide:github" aria-hidden="true" />
            Source on GitHub
          </a>
        </li>
      </ul>
    </nav>

    <div class="footer-credits">
      <h2 class="footer-heading">Data</h2>
      <p class="muted">
        We acknowledge the use of data from NASA’s Fire Information for Resource Management System
        (<a href={site.firms} rel="noopener">FIRMS</a>), part of NASA’s Earth Science Data and
        Information System (ESDIS). Hotspots come from the MODIS (Aqua) and VIIRS (Suomi NPP and
        NOAA-20) active fire products.
      </p>
    </div>

    <div class="footer-notice">
      <h2 class="footer-heading">Important</h2>
      <p class="muted">
        {site.name} is a fire activity outlook and research tool. It is not an official fire danger
        rating or warning service. Always follow advice from your local fire and emergency services.
      </p>
      <p class="muted">Not affiliated with or endorsed by NASA.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-xl) var(--space-l);
  }

  @media (min-width: 36rem) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer-grid > * > * + * {
    margin-top: var(--space-xs);
  }

  /* The logo link is a 44px tap target with the 32px logo centred in it, which
     put the logo below the other columns' headings. Pulling it up by the extra
     space lines the logo's top up with the headings (the tap target stays). */
  .footer-brand :global(.brand) {
    margin-top: calc((2rem - 2.75rem) / 2);
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .footer-links ul {
    display: grid;
    gap: var(--space-3xs);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
  }

  .footer-links :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }
</style>
