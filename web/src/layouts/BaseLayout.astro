---
import '../styles/global.css';
import Nav from '../components/layout/Nav.astro';
import AppBar from '../components/layout/AppBar.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../lib/site';

interface Props {
  /** Page title, shown before the site name. Leave out on the home page. */
  title?: string;
  description?: string;
  /** Page uses scroll-reveal animations (src/scripts/reveal.ts) */
  reveal?: boolean;
  /** 'site': the full nav with the home page's sections. 'app': a compact bar
      with the page's name and links home (the dashboard). */
  nav?: 'site' | 'app';
}

const { title, description = site.description, reveal = false, nav = 'site' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
---

<!doctype html>
<html lang="en" data-nav={nav}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <!-- Browser UI colour; must be a literal, matches --color-bg -->
    <meta name="theme-color" content="#0b0e13" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {
      reveal && (
        <script is:inline>
          // Hide scroll-reveal content before first paint (no flash), then let the
          // animation script reveal it. If that script hasn't started within 3 s,
          // show everything instead.
          document.documentElement.classList.add('js-reveal');
          setTimeout(function () {
            if (!document.documentElement.classList.contains('reveal-ready')) {
              document.documentElement.classList.remove('js-reveal');
            }
          }, 3000);
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {nav === 'app' ? <AppBar title={title ?? site.name} /> : <Nav />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/section-links';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  /* Sections receive focus after a section-link jump (src/scripts/section-links.ts);
     a focus ring around a whole section isn't useful. */
  main :global(section[id]:focus) {
    outline: none;
  }
</style>
