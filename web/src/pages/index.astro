---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Problem from '../components/home/Problem.astro';
import DataStory from '../components/home/DataStory.astro';
import TechStack from '../components/home/TechStack.astro';
import Approach from '../components/home/Approach.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import FeaturedFires from '../components/home/FeaturedFires.astro';
import Audience from '../components/home/Audience.astro';
import FireTransition from '../components/home/FireTransition.astro';

// Ambient glows behind the story: cool blue near the top, warming to ember
// lower down. top/left place each one; drift = seconds per slow drift cycle;
// parallax = how far it moves (in screen heights) as you scroll the story.
const glows = [
  { top: '2%', left: '-12%', color: '--color-sky', drift: 26, parallax: -0.3 },
  { top: '16%', left: '62%', color: '--color-sky', drift: 32, parallax: 0.25 },
  { top: '34%', left: '-8%', color: '--color-fire-glow', drift: 28, parallax: -0.2 },
  { top: '52%', left: '58%', color: '--color-sky', drift: 34, parallax: 0.3 },
  { top: '68%', left: '-14%', color: '--color-fire-glow', drift: 30, parallax: -0.25 },
  { top: '84%', left: '55%', color: '--color-fire-hot', drift: 24, parallax: 0.2 },
];
---

<BaseLayout reveal>
  <Hero />

  <!-- The story: one continuous background that warms from night to fire -->
  <div class="story">
    <div class="story-fx" aria-hidden="true">
      {
        glows.map((g) => (
          <div class="glow-track" style={`top: ${g.top}; left: ${g.left};`} data-parallax={g.parallax}>
            <div class="glow" style={`--glow-color: var(${g.color}); --drift: ${g.drift}s;`} />
          </div>
        ))
      }
    </div>
    <Problem />
    <DataStory />
    <HowItWorks />
    <TechStack />
    <Approach />
    <FeaturedFires />
    <Audience />
  </div>

  <FireTransition />
</BaseLayout>

<script>
  import '../scripts/reveal';
  import '../scripts/home-effects';
</script>

<style>
  .story {
    position: relative;
    isolation: isolate; /* glows and grain sit above this background, below the content */
    overflow: hidden;
    overflow: clip;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      var(--color-bg-dusk) 30%,
      var(--color-bg-dusk-warm) 55%,
      var(--color-bg-ember) 78%,
      var(--color-bg-warm) 100%
    );
  }

  .story-fx {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Glows fade out before the bottom edge, so none is cut off where the
       story meets the fire transition */
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 40rem), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 40rem), transparent);
  }

  /* Film grain over the whole story background (the fire transition uses the
     same texture, so it carries on without a seam) */
  .story::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--texture-grain);
    opacity: 0.05;
    pointer-events: none;
  }

  .glow-track {
    position: absolute;
    width: min(48rem, 130vw);
    aspect-ratio: 1;
  }

  .glow {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--glow-color) 16%, transparent), transparent);
    animation: glow-drift var(--drift) ease-in-out infinite alternate;
  }

  @keyframes glow-drift {
    to {
      transform: translate(5rem, -4rem) scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
  }
</style>
